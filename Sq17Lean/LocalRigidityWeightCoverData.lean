theorem owner_first : ∀ j, owner (first j) = j := by decide +kernel
theorem ordinary_bounds : ∀ j : Fin 90, j ≠ 55 → ∀ k,
    lower (first j) k = globalLower k ∧ upper (first j) k = globalUpper k := by decide +kernel
theorem halfwidths : ∀ i k, (WeightData.boxes i).half k = (upper i k-lower i k)/2 := by decide +kernel
