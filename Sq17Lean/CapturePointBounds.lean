structure TerminalPointBounds (p : Fin 17 → AnglePose) (sigma radius : ℝ) : Prop where
  fifthY : PointFunctionalBounds (p (owners 4)).center sigma 4 0 1 (-radius) radius
  eleventh : PointFunctionalBounds (p (owners 10)).center sigma 10 c s (-radius) radius
  thirteenth : PointFunctionalBounds (p (owners 12)).center sigma 12 c s (-radius) radius
  regular : ∀ i, i ≠ 4 → i ≠ 5 → i ≠ 10 → i ≠ 12 →
    PointFunctionalBounds (p (owners i)).center sigma i 1 0 (-radius) radius ∧
    PointFunctionalBounds (p (owners i)).center sigma i 0 1 (-radius) radius
  sliderA : PointFunctionalBounds (p (owners 4)).center sigma 4 (-1) 0 (-1) (1/4)
  sliderB : PointFunctionalBounds (p (owners 10)).center sigma 10 s (-c) (-1/2500) (1/12)
  sliderZ : PointFunctionalBounds (p (owners 12)).center sigma 12 (-s) c (-1/8) (1/16)

theorem terminalSummary_pointBounds (p : Fin 17 → AnglePose)
    (hc : ∀ i, SummaryPointBands i (p i).center) :
    TerminalPointBounds p terminalSigma ((1:ℝ)/10000000) := by
  constructor <;> try simp only [← neg_div]
  · exact point_terminal_4_y _ (hc _)
  · exact point_terminal_10_transverse _ (hc _)
  · exact point_terminal_12_transverse _ (hc _)
  · intro i h4 h5 h10 h12
    fin_cases i <;> try contradiction
    · exact ⟨point_terminal_0_x _ (hc _),point_terminal_0_y _ (hc _)⟩
    · exact ⟨point_terminal_1_x _ (hc _),point_terminal_1_y _ (hc _)⟩
    · exact ⟨point_terminal_2_x _ (hc _),point_terminal_2_y _ (hc _)⟩
    · exact ⟨point_terminal_3_x _ (hc _),point_terminal_3_y _ (hc _)⟩
    · exact ⟨point_terminal_6_x _ (hc _),point_terminal_6_y _ (hc _)⟩
    · exact ⟨point_terminal_7_x _ (hc _),point_terminal_7_y _ (hc _)⟩
    · exact ⟨point_terminal_8_x _ (hc _),point_terminal_8_y _ (hc _)⟩
    · exact ⟨point_terminal_9_x _ (hc _),point_terminal_9_y _ (hc _)⟩
    · exact ⟨point_terminal_11_x _ (hc _),point_terminal_11_y _ (hc _)⟩
    · exact ⟨point_terminal_13_x _ (hc _),point_terminal_13_y _ (hc _)⟩
    · exact ⟨point_terminal_14_x _ (hc _),point_terminal_14_y _ (hc _)⟩
    · exact ⟨point_terminal_15_x _ (hc _),point_terminal_15_y _ (hc _)⟩
    · exact ⟨point_terminal_16_x _ (hc _),point_terminal_16_y _ (hc _)⟩
  · exact point_terminal_4_sliderA _ (hc _)
  · exact point_terminal_10_sliderB _ (hc _)
  · exact point_terminal_12_sliderZ _ (hc _)

end
