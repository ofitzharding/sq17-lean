import Sq17Lean.CaptureTerminalBoundsData

/-! The terminal summary applies directly to real centres. No polygon hull
representation is needed. Generated by generate_point_bounds.py. -/
namespace Sq17.CaptureChart
open Sq17.Propagation Sq17.EndpointGeometry Sq17.EndpointIntervals Sq17.RationalExpression
open Sq17.LocalPerturbation
noncomputable section
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unnecessarySeqFocus false
set_option linter.unreachableTactic false

def PointFunctionalBounds (p : ℝ × ℝ) (sigma : ℝ) (i : Fin 17)
    (A B lo hi : ℝ) : Prop :=
  lo ≤ functional sigma i A B p ∧ functional sigma i A B p ≤ hi

def SummaryPointBands (i : Fin 17) (p : ℝ × ℝ) : Prop :=
  ∀ b ∈ (terminalSummary i).bands,
    b.bound.Holds ((b.a:ℝ)*p.1+(b.b:ℝ)*p.2)

theorem point_terminal_0_x (p : ℝ × ℝ)
    (hc : SummaryPointBands 11 p) :
    PointFunctionalBounds p terminalSigma 0 1 0 (-1/10000000) (1/10000000) := by
  have hx := hc
    ⟨1,0,⟨(146913404467165/35184372088832),(1175307235852485/281474976710656)⟩⟩ (by simp [terminalSummary])
  norm_num [Interval.Holds,ProjectionBand.eval] at hx
  have hy := hc
    ⟨0,1,⟨(562949953419309/1125899906842624),(281474976900967/562949953421312)⟩⟩ (by simp [terminalSummary])
  norm_num [Interval.Holds,ProjectionBand.eval] at hy
  have hp := hc
    ⟨0,1,⟨(562949953419309/1125899906842624),(281474976900967/562949953421312)⟩⟩ (by simp [terminalSummary])
  norm_num [Interval.Holds,ProjectionBand.eval] at hp
  apply functional_bound_from_projection terminalSigma 0 1 0 0 1 (562949953419309/1125899906842624) (281474976900967/562949953421312) (-1/10000000) (1/10000000) p
  · apply abs_le.mpr; constructor <;> linarith [hx.1,hx.2]
  · apply abs_le.mpr; constructor <;> linarith [hy.1,hy.2]
  · constructor <;> push_cast <;> linarith [hp.1,hp.2]
  · have h := terminal_0_x_lower_bounds.1
    norm_num [Interval.Holds] at h ⊢
    linarith
  · have h := terminal_0_x_upper_bounds.2
    norm_num [Interval.Holds] at h ⊢
    linarith

