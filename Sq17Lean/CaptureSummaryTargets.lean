theorem summaryTargets_pose (p : Fin 17 → AnglePose)
    (h : ∀ i : Fin 17, (summaryTargets[i.val]!).Holds (p i)) :
    SummaryPoseBounds p := by
  intro i
  have hi := h i
  fin_cases i
  · have hi' : target0.Holds (p 0) := by simpa [summaryTargets] using hi
    refine ⟨?_, target0_bands _ hi'.2⟩
    exact hi'.1
  · have hi' : target1.Holds (p 1) := by simpa [summaryTargets] using hi
    refine ⟨?_, target1_bands _ hi'.2⟩
    exact hi'.1
  · have hi' : target2.Holds (p 2) := by simpa [summaryTargets] using hi
    refine ⟨?_, target2_bands _ hi'.2⟩
    exact hi'.1
  · have hi' : target3.Holds (p 3) := by simpa [summaryTargets] using hi
    refine ⟨?_, target3_bands _ hi'.2⟩
    exact hi'.1
  · have hi' : target4.Holds (p 4) := by simpa [summaryTargets] using hi
    refine ⟨?_, target4_bands _ hi'.2⟩
    exact hi'.1
  · have hi' : target5.Holds (p 5) := by simpa [summaryTargets] using hi
