def faceRows : Fin 8 → Fin 19 := ![0,1,2,4,7,8,10,11]
theorem face_offsets_bounded {a b z : ℝ} (h : sliderBox a b z) (r : Fin 8) :
    |tangentialOffset a b z (contactPairs (faceRows r)).1
      (contactPairs (faceRows r)).2.1 (contactPairs (faceRows r)).2.2| ≤ 1/2 := by
  fin_cases r
  · change |tangentialOffset a b z 0 1 0| ≤ 1/2
    rw [offset_1_2]; norm_num
  · change |tangentialOffset a b z 0 2 1| ≤ 1/2
    rw [offset_1_3]; norm_num
  · change |tangentialOffset a b z 4 6 1| ≤ 1/2
    rw [offset_5_7,abs_neg,abs_of_nonneg h.1]
    linarith [h.2.1]
  · change |tangentialOffset a b z 8 9 2| ≤ 1/2
    obtain ⟨hl,hu⟩ := face_4_bounds h
    rw [abs_of_nonneg (by linarith)]
    exact hu
  · change |tangentialOffset a b z 10 11 2| ≤ 1/2
    obtain ⟨hl,hu⟩ := face_7_bounds h
    rw [abs_of_nonneg (by linarith)]
    exact hu
  · change |tangentialOffset a b z 9 11 3| ≤ 1/2
    obtain ⟨hl,hu⟩ := face_8_bounds h
    rw [abs_of_nonneg (by linarith)]
    exact hu
  · change |tangentialOffset a b z 12 13 2| ≤ 1/2
    obtain ⟨hl,hu⟩ := face_10_bounds h
    rw [abs_of_nonneg (by linarith)]
    exact hu
  · change |tangentialOffset a b z 11 13 3| ≤ 1/2
    obtain ⟨hl,hu⟩ := face_11_bounds h
    rw [abs_of_nonneg (by linarith)]
    exact hu
